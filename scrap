\section{Points d'attention --- CRUCIAL}
% =============================================================================

\begin{critbox}[R\`egles imp\'eratives pour l'int\'egration ML]
\begin{enumerate}
  \item \textbf{Ne jamais remplacer totalement les r\`egles.} Le ML est un
        compl\'ement, pas un remplacement. Les r\`egles restent la source de
        v\'erit\'e quand elles trouvent un r\'esultat.

  \item \textbf{Garder le fallback regex.} Si le ML \'echoue (confiance basse,
        erreur, mod\`ele absent), la pipeline doit continuer \`a fonctionner
        avec les r\`egles seules.

  \item \textbf{\'Eviter l'overfitting.} Avec 300 PDFs d'entra\^inement, le
        risque d'overfitting est \'elev\'e. Utiliser la validation crois\'ee
        ($k=5$) et limiter la profondeur des arbres (\texttt{max\_depth=5}).

  \item \textbf{Maintenir l'interpr\'etabilit\'e.} Privil\'egier les mod\`eles
        interpr\'etables (Random Forest, Logistic Regression) sur les bo\^ites
        noires (deep learning). L'importance des features doit \^etre
        consultable.

  \item \textbf{Pas de d\'ependances lourdes.} Pas de transformers, pas de
        HuggingFace, pas de GPU. SpaCy (\texttt{en\_core\_web\_sm}, 12~Mo)
        et scikit-learn sont les seules d\'ependances autoris\'ees.

  \item \textbf{Graceful degradation.} Si \texttt{spacy} ou
        \texttt{scikit-learn} ne sont pas install\'es, la pipeline doit
        fonctionner exactement comme avant (comme \texttt{langid} avec
        son fallback keywords).

  \item \textbf{Tester sur les 3 langues.} Chaque mod\`ele doit \^etre
        valid\'e sur des documents EN, FR et DE.

  \item \textbf{Versionner les mod\`eles.} Les fichiers \texttt{.pkl}
        (scikit-learn) et les mod\`eles SpaCy custom doivent \^etre
        versionn\'es avec le code.
\end{enumerate}
\end{critbox}


