\section{Pipeline complet propos\'e}
% =============================================================================

\begin{lstlisting}[style=pseudo]
FONCTION pipeline_v3(pdf_path):
    // Etape 1 : extraction coordonnees (INCHANGE)
    result ← coord_extractor.extract_from_pdf(pdf_path)

    // Etape 2 : detection langue (INCHANGE)
    langue ← lang_detector.detect_language(result.clean_text)

    // Etape 3 : segmentation (NOUVEAU)
    segments ← segmenter_document(result.lines)
    // segments = [("header", lignes), ("underlying_table", lignes), ...]

    // Etape 4 : features (NOUVEAU)
    features ← extraire_features(result, segments, langue)

    // Etape 5 : extraction hybride
    POUR CHAQUE champ FAIRE
        valeur ← extraire_par_regles(champ, result)
        SI valeur = None OU confiance_basse ALORS
            valeur_ml ← modele[champ].predire(features)
            SI valeur_ml.confiance > seuil ALORS
                valeur ← valeur_ml
            FIN
        FIN
    FIN

    // Etape 6 : normalisation (INCHANGE)
    resultat ← normaliser(resultat)
    RETOURNER resultat
\end{lstlisting}


