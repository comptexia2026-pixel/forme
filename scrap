\section{Roadmap d'impl\'ementation}
% =============================================================================

\subsection{Phase 1 --- Am\'eliorer les r\`egles (0--2 semaines)}

\begin{itemize}
  \item Enrichir \texttt{KNOWN\_ISSUERS} avec les 50 \'emetteurs les plus fr\'equents.
  \item Ajouter des patterns W/A pour les formulations manquantes.
  \item Ajouter la validation Luhn pour les ISINs.
  \item Ajouter un score de confiance par champ (high/medium/low).
  \item G\'erer les valeurs multi-lignes (continuation de la ligne pr\'ec\'edente).
\end{itemize}

\textbf{Crit\`ere de succ\`es} : fill rate $>$ 85\% sur un corpus de 300 PDFs
multi-\'emetteurs.

\subsection{Phase 2 --- SpaCy NER (2--4 semaines)}

\begin{itemize}
  \item Installer SpaCy + \texttt{en\_core\_web\_sm}.
  \item Impl\'ementer \texttt{\_extract\_issuer\_spacy()} comme passe~3 dans
        \texttt{\_extract\_issuer()}.
  \item \'Evaluer sur 100 PDFs avec issuer inconnu.
  \item Si n\'ecessaire, entra\^iner un mod\`ele NER custom sur les term sheets.
\end{itemize}

\textbf{Crit\`ere de succ\`es} : fill rate ISSUER $>$ 90\% sur 50 \'emetteurs.

\subsection{Phase 3 --- Mod\`ele ML pour W/A (4--6 semaines)}

\begin{itemize}
  \item Construire le dataset de features \`a partir des 300 PDFs annot\'es.
  \item Entra\^iner un Random Forest avec validation crois\'ee.
  \item Int\'egrer comme fallback apr\`es les patterns regex.
  \item Calibrer le seuil de confiance (objectif : pr\'ecision $>$ 90\%).
\end{itemize}

\textbf{Crit\`ere de succ\`es} : fill rate W/A $>$ 90\%, pr\'ecision $>$ 90\%.

\subsection{Phase 4 --- Hybridation compl\`ete (6--8 semaines)}

\begin{itemize}
  \item Unifier le pipeline r\`egles + ML dans une classe \texttt{HybridExtractor}.
  \item Ajouter un dashboard de monitoring (fill rate, confiance, erreurs).
  \item Impl\'ementer le <<~graceful degradation~>> (fallback si ML absent).
  \item Documenter et versionner les mod\`eles.
\end{itemize}

\textbf{Crit\`ere de succ\`es} : pipeline stable sur 500+ PDFs, fill rate
moyen $>$ 92\%, aucune r\'egression sur les PDFs BIL.


