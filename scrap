\section{Points critiques --- \`A ne pas casser}
% =============================================================================

\subsection{Param\`etres sensibles}

\begin{critbox}[Ne JAMAIS modifier sans revalidation compl\`ete]
\begin{tabularx}{\textwidth}{lclX}
\toprule
\textbf{Param\`etre} & \textbf{Valeur} & \textbf{Fichier} & \textbf{Si modifi\'e} \\
\midrule
\texttt{WORD\_X\_TOLERANCE} & 1 & config.py & Collage de mots $\rightarrow$ pipeline cass\'ee \\
\texttt{WORD\_Y\_TOLERANCE} & 1 & config.py & Fusion verticale des mots \\
\texttt{LINE\_Y\_THRESHOLD} & 3.0 & config.py & Lignes fusionn\'ees ou \'eclat\'ees \\
\texttt{COLUMN\_GAP\_MIN} & 20.0 & config.py & Fausse d\'etection de colonnes \\
\bottomrule
\end{tabularx}
\end{critbox}

\subsection{Logiques \`a pr\'eserver}

\begin{critbox}[Invariants du syst\`eme]
\begin{enumerate}
  \item \textbf{Priorit\'e stricte} : paires > regex > inf\'erence.
        L'inf\'erence SSPA ne doit jamais \'ecraser une valeur explicite.
  \item \textbf{Ordre dans \texttt{extract\_all()}} : les variables
        \texttt{underlying\_isins} et \texttt{bloomberg\_tickers} doivent
        \^etre calcul\'ees \textbf{avant} d'\^etre pass\'ees \`a
        \texttt{\_extract\_worst\_or\_average()}.
  \item \textbf{Scoring ISIN} : la p\'enalit\'e +800 pour les ISINs pr\`es de
        <<~Bloomberg~>> est essentielle pour ne pas confondre PST et underlying.
  \item \textbf{Normalisation en dernier} : \texttt{\_normalise()} est appel\'ee
        apr\`es tous les \texttt{\_extract\_*()}, jamais avant.
  \item \textbf{BIL YES en tout dernier} : l'override BIL YES est appliqu\'e
        apr\`es \texttt{\_normalise()}, juste avant le return.
  \item \textbf{Worst/Average retourne <<~nan~>>} : pas \texttt{None}, pas
        \texttt{""}, mais la cha\^ine \texttt{"nan"} pour homog\'en\'eit\'e Excel.
\end{enumerate}
\end{critbox}

\subsection{D\'ependances fortes entre modules}

\begin{critbox}[Cha\^ine de d\'ependances]
\begin{itemize}
  \item \texttt{config.py} est import\'e par \textbf{tous} les modules. Toute
        modification ici impacte potentiellement tout.
  \item Si un champ est ajout\'e/supprim\'e dans \texttt{field\_extractor}, il
        faut aussi modifier \texttt{MAIN\_COLUMNS} dans \texttt{excel\_exporter}
        et potentiellement \texttt{FIELD\_COLORS} + \texttt{SKIP\_FIELDS} dans
        \texttt{highlighter}.
  \item Le highlighting tourne \textbf{avant} l'export Excel dans \texttt{main.py}
        (car le nom du fichier annot\'e est dans l'Excel).
  \item Les cl\'es commen\c{c}ant par \texttt{\_} dans le dict r\'esultat
        (\texttt{\_WA\_SOURCE}, \texttt{\_CP\_SOURCE}, \texttt{\_IS\_BIL\_YES})
        sont des m\'etadonn\'ees pour le highlighter. Elles ne doivent pas
        appara\^itre dans l'Excel.
\end{itemize}
\end{critbox}


